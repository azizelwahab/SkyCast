# Copy to .env for local use (Node 20.6+: node --env-file=.env server.js).
# Every value is optional; defaults are shown.
PORT=3000
NODE_ENV=development
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=500
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
UPSTREAM_TIMEOUT_MS=8000
# Number of reverse proxies in front of the app (Render: 1). Needed for correct per-user rate limiting.
TRUST_PROXY=
